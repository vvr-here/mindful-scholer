# -----------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (DEVELOPMENT / LOCAL)
# Copy this file to '.env' to use it locally.
# -----------------------------------------------------------------------------

# Port where the Express server will run
PORT=4000

# PostgreSQL Database Connection String
# e.g., postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/mindful_scholar?schema=public"

# JSON Web Token Secret (used to sign auth tokens)
# Generate a secure string (e.g., using `require("crypto").randomBytes(64).toString("hex")` in Node)
JWT_SECRET="local_development_secret_do_not_use_in_production"

# CORS Configuration (comma-separated allowed domains)
ALLOWED_ORIGINS="http://localhost:5173"

# Environment Mode
NODE_ENV="development"
