# -----------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (PRODUCTION)
# Use these keys in your PaaS provider's dashboard (e.g., Render, Railway).
# DO NOT COMMIT ACTUAL SECRETS TO GIT.
# -----------------------------------------------------------------------------

# Port often provided dynamically by the hosting service
PORT=4000

# Production Managed PostgreSQL Database URL
DATABASE_URL="postgresql://<production-user>:<production-pass>@<db-host>.com:5432/<db-name>?sslmode=require"

# Secure JSON Web Token Secret
JWT_SECRET="<YOUR_VERY_LONG_SECURE_RANDOM_STRING_HERE>"

# CORS Configuration (whitelist exact allowed domains)
ALLOWED_ORIGINS="https://your-frontend-domain.vercel.app,https://www.your-frontend-domain.com"

# Environment Mode
NODE_ENV="production"
